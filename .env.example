# ============================================================
# DocVerify AI — Environment Configuration Template
# Copy this file to .env and fill in your own values.
# ============================================================

# Neon PostgreSQL (or any PostgreSQL) connection string
# Get yours from: https://console.neon.tech
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# JWT Secret — change to a long random string in production
SECRET_KEY=change-me-to-a-long-random-secret-key

# JWT Settings
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
